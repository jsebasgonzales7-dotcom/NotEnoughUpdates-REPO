# noclip_debug.gd — adjunta a CharacterBody3D (Godot 4)
extends CharacterBody3D

@export var speed := 6.0
@export var sprint := 2.5
var noclip := false

func _input(event):
    if event.is_action_pressed("ui_noclip"): # configura esta acción en InputMap
        noclip = !noclip
        $CollisionShape3D.disabled = noclip
        print("Noclip:", noclip)

func _physics_process(delta):
    if noclip:
        var dir = Vector3.ZERO
        if Input.is_action_pressed("move_forward"): dir -= transform.basis.z
        if Input.is_action_pressed("move_back"): dir += transform.basis.z
        if Input.is_action_pressed("move_left"): dir -= transform.basis.x
        if Input.is_action_pressed("move_right"): dir += transform.basis.x
        if Input.is_action_pressed("move_up"): dir += transform.basis.y
        if Input.is_action_pressed("move_down"): dir -= transform.basis.y

        var cur_speed = speed * (Input.is_action_pressed("ui_sprint") ? sprint : 1.0)
        global_translate(dir.normalized() * cur_speed * delta)
    else:
        # lógica normal de movimiento aquí
        pass
